#usda 1.0
(
    defaultPrim = "Drill"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Drill" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    float physics:mass = 0.6

    def "Looks"
    {
        def Material "body"
        {
            token outputs:surface.connect = </Drill/Looks/body/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.2, 0.36, 0.62)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "grip"
        {
            token outputs:surface.connect = </Drill/Looks/grip/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.06, 0.06, 0.07)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }

        def Material "black"
        {
            token outputs:surface.connect = </Drill/Looks/black/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.08, 0.08, 0.09)
                float inputs:metallic = 0.2
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "trigger"
        {
            token outputs:surface.connect = </Drill/Looks/trigger/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.85, 0.1, 0.06)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "accent"
        {
            token outputs:surface.connect = </Drill/Looks/accent/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.85, 0.85, 0.85)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
    }

    def Mesh "Housing" (
